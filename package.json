{
  "name": "quoridor-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "dev:server": "pnpm --filter @quoridor/server run start:dev",
    "dev:web": "pnpm --filter @quoridor/web run dev",
    "dev": "concurrently -n server,web -c magenta,cyan \"pnpm run dev:server\" \"pnpm run dev:web\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  }
}
